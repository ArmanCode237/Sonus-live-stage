{
  "name": "live-stage-webui",
  "private": true,
  "version": "30.0.0",
  "type": "module",
  "description": "Live Stage control surface (React). Built into ../ui/app and served by the C++ host.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
