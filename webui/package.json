    "smoke:shimmer": "node scripts/shimmer-smoke.mjs",
    "smoke:ws": "node scripts/ws-smoke.mjs",
    "smoke:synth": "node scripts/synth-v31-smoke.mjs",
    "smoke:synth-library": "node scripts/synth-library-smoke.mjs",
    "smoke:mappings": "node scripts/mapping-smoke.mjs",
    "smoke:piano-sounds": "node scripts/piano-sound-smoke.mjs",
    "audit:layout": "node scripts/layout-audit.mjs",
